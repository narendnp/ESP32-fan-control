#include <Arduino.h>
#define BLYNK_TEMPLATE_ID "TMPL6hddHDFs6"
#define BLYNK_TEMPLATE_NAME "ESP32 DHT2"
#define BLYNK_AUTH_TOKEN "61TElpvS8bljISqfq7cowAw-B8uEu7yp"

#include <WiFi.h>
#include <DHT.h>
#include <BlynkSimpleEsp32.h>

const char *WIFI_NAME = "MR- IR62";
const char *WIFI_PASSWORD = "tukadirawadi";
#define DHTPIN 32 // Pin data sensor DHT22 ke GPIO 32
#define DHTTYPE DHT22 // Tipe sensor DHT22

WiFiClient client;
DHT dht(DHTPIN, DHTTYPE);
BlynkTimer timer;

void sendSensor()
{
  // float suhu = dht.readTemperature();    // Dalam Celcius
  // float kelembapan = dht.readHumidity(); // Dalam %
  // if (isnan(suhu) || isnan(kelembapan))
  // {
  //   Serial.println("Gagal membaca sensor DHT22!");
  //   return;
  // }

  float suhu = random(240, 270) / 10.0;        // Simulasi suhu antara 24.0°C dan 27.0°C
  float kelembapan = random(400, 500) / 10.0; // Simulasi kelembapan antara 40.0% dan 50.0%

  // kirim ke Blynk
  Blynk.virtualWrite(V0, suhu);
  Blynk.virtualWrite(V1, kelembapan);
  // biar kelihatan di Serial
  Serial.println("Temp: " + String(suhu, 2) + " °C");
  Serial.println("Hum : " + String(kelembapan, 1) + " %");
  Serial.println("----");
}

void setup()
{
  Serial.begin(115200);
  dht.begin();
  Serial.println("Membaca sensor DHT22...");
  WiFi.begin(WIFI_NAME, WIFI_PASSWORD);
  while (WiFi.status() != WL_CONNECTED)
  {
    delay(1000);
    Serial.println("Wifi not connected");
  }
  Serial.println("Wifi connected !");
  Serial.println("Local IP: " + String(WiFi.localIP()));
  WiFi.mode(WIFI_STA);
  Blynk.begin(BLYNK_AUTH_TOKEN, WIFI_NAME, WIFI_PASSWORD);  // kirim data tiap 5 detik
  timer.setInterval(5000L, sendSensor);
}

void loop()
{
  Blynk.run();
  timer.run();
}
